# ---------------------------------------------------------------------------
# Pick ONE provider. Leave everything unset to run fully offline (no keys).
# AGENT_PROVIDER overrides auto-detection: offline | azure | foundry | openai | anthropic | ollama
# ---------------------------------------------------------------------------
# AGENT_PROVIDER=offline

# --- Azure OpenAI (Responses API via OpenAIChatClient) ---------------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_CHAT_MODEL=gpt-5.4-mini
# AZURE_OPENAI_API_KEY=            # omit to use `az login` (AzureCliCredential)
# AZURE_OPENAI_API_VERSION=        # optional

# --- Microsoft Foundry -------------------------------------------------------
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=gpt-5.4-mini       # uses `az login` (AzureCliCredential)

# --- OpenAI ------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# --- Ollama (local) ----------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2

# --- Observability (optional) ------------------------------------------------
# ENABLE_SENSITIVE_DATA=true                     # include prompts/tool args in spans (dev only)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # e.g. Aspire Dashboard
# OFFLINE_DELAY=0.02                              # streaming "typing" delay for the offline provider
